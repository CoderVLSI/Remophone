{
  "expo": {
    "name": "RemoPhone",
    "slug": "remophone",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.remophone.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a0a06"
      }
    },
    "extra": {
      "eas": {
        "projectId": "53f8a8c6-95f7-4c4c-bb74-2eb63bab55ae"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-av",
        {
          "microphonePermission": "Allow RemoPhone to use the microphone for voice and dictation."
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "icon": "./assets/icon.png"
  }
}
