{
  "name": "remophone",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "relay": "node relay-server.js",
    "test:duet": "esbuild scripts/test-duet.mjs --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=.test-build/test-duet.mjs --log-level=warning && node .test-build/test-duet.mjs",
    "apk": "eas build -p android --profile preview"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~51.0.28",
    "expo-av": "~14.0.7",
    "expo-file-system": "~17.0.1",
    "expo-font": "~12.0.10",
    "expo-secure-store": "~13.0.2",
    "expo-sharing": "~12.0.1",
    "expo-status-bar": "~1.12.1",
    "pptxgenjs": "^4.0.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-svg": "15.2.0",
    "react-native-web": "~0.19.10"
  },
  "devDependencies": {
    "babel-preset-expo": "~11.0.10",
    "esbuild": "^0.28.2",
    "simple-icons": "^16.35.0",
    "simple-icons-legacy": "npm:simple-icons@^11.14.0",
    "ws": "^8.18.0"
  }
}
